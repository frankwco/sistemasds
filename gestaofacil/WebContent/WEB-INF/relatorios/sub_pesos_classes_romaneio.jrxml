<!-- Created with Jaspersoft Studio version 6.10.0.final using JasperReports Library version 6.10.0-unknown  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="sub_pesos_classes_romaneio" pageWidth="595" pageHeight="100" columnWidth="594" leftMargin="0" rightMargin="1" topMargin="5" bottomMargin="5" isIgnorePagination="true" uuid="fad7f853-c3ba-4c15-a1a2-a7902f70b0f7">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="GestaoFacil"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="234"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="758"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="ID_FECHAMENTO_MES" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT gestaofacil.coleta.`dataColeta`,
	gestaofacil.coleta.observacao,
	gestaofacil.pessoa.`nomeRazaoSocial`,
	gestaofacil.pessoa.`nomeFantasia`,
	gestaofacil.coleta.`fechamentoMes_id`,
	gestaofacil.coleta.id,
	(SELECT sum( gestaofacil.itens_coleta.quantidadeColetada)
FROM gestaofacil.itens_coleta
	INNER JOIN gestaofacil.coleta ON 
	 gestaofacil.itens_coleta.coleta_id = gestaofacil.coleta.id 
	INNER JOIN gestaofacil.grupo_residuos ON 
	 gestaofacil.itens_coleta.`grupoResiduo_id` = gestaofacil.grupo_residuos.id 
WHERE 
	 gestaofacil.coleta.`fechamentoMes_id` = $P{ID_FECHAMENTO_MES} 
	 AND gestaofacil.grupo_residuos.descricao = 'A' 
	 AND gestaofacil.grupo_residuos.status = 'NULL' 
	 AND gestaofacil.coleta.`pontoColeta_id` = 'NULL' ) AS quantidadeA,
	(SELECT sum( gestaofacil.itens_coleta.quantidadeColetada)
FROM gestaofacil.itens_coleta
	INNER JOIN gestaofacil.coleta ON 
	 gestaofacil.itens_coleta.coleta_id = gestaofacil.coleta.id 
	INNER JOIN gestaofacil.grupo_residuos ON 
	 gestaofacil.itens_coleta.`grupoResiduo_id` = gestaofacil.grupo_residuos.id 
WHERE 
	 gestaofacil.coleta.`fechamentoMes_id` = $P{ID_FECHAMENTO_MES} 
	 AND gestaofacil.grupo_residuos.descricao = 'E' 
	 AND gestaofacil.grupo_residuos.status = 'NULL' 
	 AND gestaofacil.coleta.`pontoColeta_id` = 'NULL' ) AS quantidadeE,
	(SELECT sum( gestaofacil.itens_coleta.quantidadeColetada)
FROM gestaofacil.itens_coleta
	INNER JOIN gestaofacil.coleta ON 
	 gestaofacil.itens_coleta.coleta_id = gestaofacil.coleta.id 
	INNER JOIN gestaofacil.grupo_residuos ON 
	 gestaofacil.itens_coleta.`grupoResiduo_id` = gestaofacil.grupo_residuos.id 
WHERE 
	 gestaofacil.coleta.`fechamentoMes_id` = $P{ID_FECHAMENTO_MES} 
	 AND gestaofacil.grupo_residuos.descricao = 'B' 
	 AND gestaofacil.grupo_residuos.status = 'NULL' 
	 AND gestaofacil.coleta.`pontoColeta_id` = 'NULL' ) AS quantidadeB,
	(SELECT sum( gestaofacil.itens_coleta.quantidadeColetada)
FROM gestaofacil.itens_coleta
	INNER JOIN gestaofacil.coleta ON 
	 gestaofacil.itens_coleta.coleta_id = gestaofacil.coleta.id 
	INNER JOIN gestaofacil.grupo_residuos ON 
	 gestaofacil.itens_coleta.`grupoResiduo_id` = gestaofacil.grupo_residuos.id 
WHERE 
	 gestaofacil.coleta.`fechamentoMes_id` = $P{ID_FECHAMENTO_MES} 
	 AND gestaofacil.grupo_residuos.descricao = 'A2' 
	 AND gestaofacil.grupo_residuos.status = 'NULL' 
	 AND gestaofacil.coleta.`pontoColeta_id` = 'NULL' ) AS quantidadeA2,
	(SELECT sum( gestaofacil.itens_coleta.quantidadeColetada)
FROM gestaofacil.itens_coleta
	INNER JOIN gestaofacil.coleta ON 
	 gestaofacil.itens_coleta.coleta_id = gestaofacil.coleta.id 
	INNER JOIN gestaofacil.grupo_residuos ON 
	 gestaofacil.itens_coleta.`grupoResiduo_id` = gestaofacil.grupo_residuos.id 
WHERE 
	 gestaofacil.coleta.`fechamentoMes_id` = $P{ID_FECHAMENTO_MES} 
	 AND gestaofacil.grupo_residuos.descricao = 'A3' 
	 AND gestaofacil.grupo_residuos.status = 'NULL' 
	 AND gestaofacil.coleta.`pontoColeta_id` = 'NULL' ) AS quantidadeA3,
	(SELECT sum( gestaofacil.itens_coleta.quantidadeColetada)
FROM gestaofacil.itens_coleta
	INNER JOIN gestaofacil.coleta ON 
	 gestaofacil.itens_coleta.coleta_id = gestaofacil.coleta.id 
	INNER JOIN gestaofacil.grupo_residuos ON 
	 gestaofacil.itens_coleta.`grupoResiduo_id` = gestaofacil.grupo_residuos.id 
WHERE 
	 gestaofacil.coleta.`fechamentoMes_id` = $P{ID_FECHAMENTO_MES} 
	 AND gestaofacil.grupo_residuos.descricao = 'A4' 
	 AND gestaofacil.grupo_residuos.status = 'NULL' 
	 AND gestaofacil.coleta.`pontoColeta_id` = 'NULL' ) AS quantidadeA4,
	 
    (SELECT GROUP_CONCAT(DISTINCT gestaofacil.grupo_residuos.descricao ORDER BY gestaofacil.grupo_residuos.descricao ASC SEPARATOR ', ')
     FROM gestaofacil.itens_coleta
     INNER JOIN gestaofacil.grupo_residuos 
         ON gestaofacil.itens_coleta.`grupoResiduo_id` = gestaofacil.grupo_residuos.id
     INNER JOIN gestaofacil.coleta 
         ON gestaofacil.itens_coleta.coleta_id = gestaofacil.coleta.id
     WHERE 
         gestaofacil.coleta.`fechamentoMes_id` = $P{ID_FECHAMENTO_MES}) AS gruposResiduos
         
FROM gestaofacil.coleta
	INNER JOIN gestaofacil.ponto_coleta ON 
	 gestaofacil.coleta.`pontoColeta_id` = gestaofacil.ponto_coleta.id 
	INNER JOIN gestaofacil.pessoa ON 
	 gestaofacil.ponto_coleta.id = gestaofacil.pessoa.id 
WHERE 
	 gestaofacil.coleta.`fechamentoMes_id` = $P{ID_FECHAMENTO_MES} 
GROUP BY gestaofacil.ponto_coleta.id]]>
	</queryString>
