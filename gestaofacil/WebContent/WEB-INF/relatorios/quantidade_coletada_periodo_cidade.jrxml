	<parameter name="DATA_INICIAL" class="java.lang.String"/>
	<parameter name="DATA_FINAL" class="java.lang.String"/>
	<parameter name="DATA_INICIAL_MOSTRAR" class="java.lang.String"/>
	<parameter name="DATA_FINAL_MOSTRAR" class="java.lang.String"/>
	<parameter name="ID_CIDADE" class="java.lang.Long"/>
	<parameter name="Parameter2" class="java.lang.String"/>
	<parameter name="CIDADE_ESTADO" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT grupo_residuos.descricao, grupo_residuos.definicao, grupo_residuos.destino, sum(itens_coleta.quantidadeColetada), coleta.dataColeta, pessoa.cidade_id, ocultarRelatorio FROM `grupo_residuos` inner join itens_coleta on grupo_residuos.id=itens_coleta.grupoResiduo_id INNER JOIN coleta on itens_coleta.coleta_id=coleta.id INNER JOIN ponto_coleta ON ponto_coleta.id = coleta.pontoColeta_id INNER JOIN pessoa ON ponto_coleta.id=pessoa.id INNER JOIN cliente on cliente.id = ponto_coleta.cliente_id where (ocultarRelatorio is false or ocultarRelatorio is null) and coleta.status is true and coleta.dataColeta BETWEEN  $P{DATA_INICIAL}  and  $P{DATA_FINAL} AND pessoa.cidade_id=$P{ID_CIDADE}  GROUP BY grupo_residuos.descricao]]>
	</queryString>
	<field name="descricao" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="descricao"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="grupo_residuos"/>
	</field>
	<field name="definicao" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="definicao"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="grupo_residuos"/>
	</field>
	<field name="destino" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="destino"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="grupo_residuos"/>
	</field>
	<field name="sum(itens_coleta.quantidadeColetada)" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="sum(itens_coleta.quantidadeColetada)"/>
	</field>
	<field name="dataColeta" class="java.sql.Date">
		<property name="com.jaspersoft.studio.field.label" value="dataColeta"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="coleta"/>
	</field>
	<field name="cidade_id" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.label" value="cidade_id"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="pessoa"/>
	</field>
	<field name="ocultarRelatorio" class="java.lang.Boolean">
		<property name="com.jaspersoft.studio.field.label" value="ocultarRelatorio"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="cliente"/>
	</field>
	<variable name="TOTAL_COLETADO" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{sum(itens_coleta.quantidadeColetada)}]]></variableExpression>
	</variable>
