	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Gestão Lite"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="207"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="786"/>
	<parameter name="ID_ROTA" class="java.lang.Long"/>
	<parameter name="ID_CIDADE" class="java.lang.Long"/>
	<queryString>
		<![CDATA[SELECT ponto.id,
	gestaofacil.pessoa.`nomeFantasia`,
	gestaofacil.pessoa.`nomeRazaoSocial`,
	gestaofacil.pessoa.cidade_id,
	gestaofacil.pessoa.endereco,
	gestaofacil.pessoa.numero,
	gestaofacil.pessoa.status,
	gestaofacil.pessoa.apelido,
	ponto.razaoSocialCliente,
	ponto.ordem,
	gestaofacil.cidade.nome
FROM gestaofacil.ponto_coleta as ponto
	INNER JOIN gestaofacil.pessoa ON 
	 ponto.id = gestaofacil.pessoa.id 
	INNER JOIN gestaofacil.cidade ON 
	 gestaofacil.pessoa.cidade_id = gestaofacil.cidade.id 
	 AND gestaofacil.pessoa.`cidade_id` = gestaofacil.cidade.id 
WHERE 
	 ponto.rota_id = $P{ID_ROTA} and gestaofacil.pessoa.cidade_id =  $P{ID_CIDADE} 
	 AND gestaofacil.pessoa.status = true AND 
     
     (SELECT COUNT(informacoes_financeiras.id) from ponto_coleta INNER JOIN itens_informacoes_financeiras_ponto_coleta ON ponto_coleta.id=itens_informacoes_financeiras_ponto_coleta.pontoColeta_id
INNER JOIN informacoes_financeiras on itens_informacoes_financeiras_ponto_coleta.informacoesFinanceiras_id=informacoes_financeiras.id WHERE ponto_coleta.id=ponto.id and informacoes_financeiras.situacaoContrato='Ativo')>0

ORDER BY ponto.ordem asc, gestaofacil.cidade.nome asc, ponto.razaoSocialCliente asc,
	gestaofacil.pessoa.`nomeRazaoSocial` ASC]]>
	</queryString>
