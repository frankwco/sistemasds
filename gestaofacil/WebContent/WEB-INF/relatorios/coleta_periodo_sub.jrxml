	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="295"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="698"/>
	<property name="com.jaspersoft.studio.report.description" value=""/>
	<parameter name="PONTO_COLETA_ID" class="java.lang.Long"/>
	<parameter name="DATA_INICIAL" class="java.lang.String"/>
	<parameter name="DATA_FINAL" class="java.lang.String"/>
	<parameter name="DADOS" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT cidade.nome as nomeCidade, pessoa.nomeRazaoSocial, ponto_coleta.id as idPontoColeta, ocultarRelatorio, 

(SELECT sum(itens_coleta.quantidadeColetada)FROM `grupo_residuos` inner join itens_coleta on grupo_residuos.id=itens_coleta.grupoResiduo_id INNER JOIN coleta on itens_coleta.coleta_id=coleta.id where coleta.dataColeta BETWEEN  $P{DATA_INICIAL} and  $P{DATA_FINAL} and grupo_residuos.descricao='A' and coleta.status is true and itens_coleta.status is true and coleta.pontoColeta_id = idPontoColeta  GROUP BY grupo_residuos.descricao) as quantidadeA,

(SELECT sum(itens_coleta.quantidadeColetada)FROM `grupo_residuos` inner join itens_coleta on grupo_residuos.id=itens_coleta.grupoResiduo_id INNER JOIN coleta on itens_coleta.coleta_id=coleta.id where coleta.dataColeta BETWEEN  $P{DATA_INICIAL}  and  $P{DATA_FINAL} and grupo_residuos.descricao='E' and coleta.status is true and itens_coleta.status is true  and coleta.pontoColeta_id = idPontoColeta  GROUP BY grupo_residuos.descricao) as quantidadeE,

(SELECT sum(itens_coleta.quantidadeColetada)FROM `grupo_residuos` inner join itens_coleta on grupo_residuos.id=itens_coleta.grupoResiduo_id INNER JOIN coleta on itens_coleta.coleta_id=coleta.id where coleta.dataColeta BETWEEN  $P{DATA_INICIAL}  and  $P{DATA_FINAL} and grupo_residuos.descricao='B' and coleta.status is true and itens_coleta.status is true  and coleta.pontoColeta_id = idPontoColeta  GROUP BY grupo_residuos.descricao) as quantidadeB,

(SELECT sum(itens_coleta.quantidadeColetada)FROM `grupo_residuos` inner join itens_coleta on grupo_residuos.id=itens_coleta.grupoResiduo_id INNER JOIN coleta on itens_coleta.coleta_id=coleta.id where coleta.dataColeta BETWEEN  $P{DATA_INICIAL}   and  $P{DATA_FINAL} and grupo_residuos.descricao='A2' and coleta.status is true and itens_coleta.status is true  and coleta.pontoColeta_id = idPontoColeta  GROUP BY grupo_residuos.descricao) as quantidadeA2,

(SELECT sum(itens_coleta.quantidadeColetada)FROM `grupo_residuos` inner join itens_coleta on grupo_residuos.id=itens_coleta.grupoResiduo_id INNER JOIN coleta on itens_coleta.coleta_id=coleta.id where coleta.dataColeta BETWEEN  $P{DATA_INICIAL}   and  $P{DATA_FINAL} and grupo_residuos.descricao='A3' and coleta.status is true and itens_coleta.status is true  and coleta.pontoColeta_id = idPontoColeta  GROUP BY grupo_residuos.descricao) as quantidadeA3,

(SELECT sum(itens_coleta.quantidadeColetada)FROM `grupo_residuos` inner join itens_coleta on grupo_residuos.id=itens_coleta.grupoResiduo_id INNER JOIN coleta on itens_coleta.coleta_id=coleta.id where coleta.dataColeta BETWEEN  $P{DATA_INICIAL}   and  $P{DATA_FINAL} and grupo_residuos.descricao='A4' and coleta.status is true and itens_coleta.status is true  and coleta.pontoColeta_id = idPontoColeta  GROUP BY grupo_residuos.descricao) as quantidadeA4
 
from ponto_coleta INNER JOIN pessoa ON ponto_coleta.id = pessoa.id INNER JOIN cidade ON cidade.id = pessoa.cidade_id INNER JOIN cliente on cliente.id=ponto_coleta.cliente_id where (ocultarRelatorio is false or ocultarRelatorio is null) GROUP BY ponto_coleta.id ORDER BY cidade.nome, pessoa.nomeRazaoSocial]]>
	</queryString>
