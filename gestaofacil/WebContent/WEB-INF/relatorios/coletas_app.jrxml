<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="coletas_app" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" isFloatColumnFooter="true" uuid="ebd2b0cc-8827-4087-be9c-07468241e2b2">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="GestaoFacil"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="264"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="728"/>
	<parameter name="DATA_INICIAL" class="java.lang.String"/>
	<parameter name="DATA_FINAL" class="java.lang.String"/>
	<parameter name="DATA_FORMATADA" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT estado.sigla,
	coleta_app.id AS idColetaApp,
	coleta_app.a,
	coleta_app.a2,
	coleta_app.a3,
	coleta_app.b,
	coleta_app.e,
	coleta_app.`dataUltimaColeta`,
	DATE_FORMAT(coleta_app.`dataUltimaColeta`, '%Y-%m-%d') as dataFormatada,
	pessoa.`nomeRazaoSocial`,
	pessoa.endereco,
	pessoa.numero,
	cidade.nome AS nomeCidade,
	ponto_coleta.status AS statusPontoColeta,
	coleta_app.status AS statusColetaApp,
	ponto_coleta.id AS idPontoColeta,
	pessoa.id AS idPessoa,
	coleta_app.veiculo_id,
	coleta_app.`emailUsuario`,
	veiculo.descricao as descricaoVeiculo
FROM coleta_app
	INNER JOIN ponto_coleta ON 
	 coleta_app.`pontoColetaSelecionado_id` = ponto_coleta.id 
	INNER JOIN pessoa ON 
	 ponto_coleta.id = pessoa.id 
	INNER JOIN cidade ON 
	 pessoa.cidade_id = cidade.id 
	INNER JOIN estado ON 
	 cidade.estado_id = estado.id 
	INNER JOIN veiculo ON 
	 coleta_app.veiculo_id = veiculo.id where coleta_app.dataUltimaColeta 
	 BETWEEN  $P{DATA_INICIAL} AND  $P{DATA_FINAL}  
	 AND coleta_app.status is true order by veiculo_id, coleta_app.`emailUsuario`, dataFormatada desc]]>
	</queryString>
