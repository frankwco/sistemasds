	<property name="com.jaspersoft.studio.report.description" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="GestaoFacil"/>
	<parameter name="PONTO_COLETA_ID" class="java.lang.Long"/>
	<parameter name="DATA_INICIAL" class="java.lang.String"/>
	<parameter name="DATA_FINAL" class="java.lang.String"/>
	<parameter name="DADOS" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
 fechamento_mes.dataInicialFechamento,
  fechamento_mes.dataFinalFechamento,
  informacoes_financeiras.fechamentoDataDiferente,
  fechamento_mes.mes,
  fechamento_mes.ano,
  fechamento_mes.id as idFechamentoMes,
    
      (SELECT
	sum(gestaofacil.itens_coleta.quantidadeColetada)
FROM gestaofacil.itens_coleta 
       INNER JOIN coleta ON
       itens_coleta.coleta_id = coleta.id
	INNER JOIN gestaofacil.grupo_residuos ON 
	 gestaofacil.itens_coleta.`grupoResiduo_id` = gestaofacil.grupo_residuos.id 
WHERE 
	 gestaofacil.itens_coleta.coleta_id = coleta.id  and gestaofacil.grupo_residuos.descricao = 'A' and 
	 gestaofacil.grupo_residuos.status = true and coleta.fechamentoMes_id = fechamento_mes.id and coleta.pontoColeta_id = $P{PONTO_COLETA_ID}  ) as quantidadeA,
     
      (SELECT
	sum(gestaofacil.itens_coleta.quantidadeColetada)
FROM gestaofacil.itens_coleta 
       INNER JOIN coleta ON
       itens_coleta.coleta_id = coleta.id
	INNER JOIN gestaofacil.grupo_residuos ON 
	 gestaofacil.itens_coleta.`grupoResiduo_id` = gestaofacil.grupo_residuos.id 
WHERE 
	 gestaofacil.itens_coleta.coleta_id = coleta.id  and gestaofacil.grupo_residuos.descricao = 'E' and 
	 gestaofacil.grupo_residuos.status = true and coleta.fechamentoMes_id = fechamento_mes.id and coleta.pontoColeta_id = $P{PONTO_COLETA_ID}) as quantidadeE,
     
      (SELECT
	sum(gestaofacil.itens_coleta.quantidadeColetada)
FROM gestaofacil.itens_coleta 
       INNER JOIN coleta ON
       itens_coleta.coleta_id = coleta.id
	INNER JOIN gestaofacil.grupo_residuos ON 
	 gestaofacil.itens_coleta.`grupoResiduo_id` = gestaofacil.grupo_residuos.id 
WHERE 
	 gestaofacil.itens_coleta.coleta_id = coleta.id  and gestaofacil.grupo_residuos.descricao = 'B' and 
	 gestaofacil.grupo_residuos.status = true and coleta.fechamentoMes_id = fechamento_mes.id and coleta.pontoColeta_id = $P{PONTO_COLETA_ID}) as quantidadeB,
     
      (SELECT
	sum(gestaofacil.itens_coleta.quantidadeColetada)
FROM gestaofacil.itens_coleta 
       INNER JOIN coleta ON
       itens_coleta.coleta_id = coleta.id
	INNER JOIN gestaofacil.grupo_residuos ON 
	 gestaofacil.itens_coleta.`grupoResiduo_id` = gestaofacil.grupo_residuos.id 
WHERE 
	 gestaofacil.itens_coleta.coleta_id = coleta.id  and gestaofacil.grupo_residuos.descricao = 'A2' and 
	 gestaofacil.grupo_residuos.status = true and coleta.fechamentoMes_id = fechamento_mes.id and coleta.pontoColeta_id = $P{PONTO_COLETA_ID}) as quantidadeA2,
     
      (SELECT
	sum(gestaofacil.itens_coleta.quantidadeColetada)
FROM gestaofacil.itens_coleta 
       INNER JOIN coleta ON
       itens_coleta.coleta_id = coleta.id
	INNER JOIN gestaofacil.grupo_residuos ON 
	 gestaofacil.itens_coleta.`grupoResiduo_id` = gestaofacil.grupo_residuos.id 
WHERE 
	 gestaofacil.itens_coleta.coleta_id = coleta.id  and gestaofacil.grupo_residuos.descricao = 'A3' and 
	 gestaofacil.grupo_residuos.status = true and coleta.fechamentoMes_id = fechamento_mes.id and coleta.pontoColeta_id = $P{PONTO_COLETA_ID}) as quantidadeA3,
     
      (SELECT
	sum(gestaofacil.itens_coleta.quantidadeColetada)
FROM gestaofacil.itens_coleta 
       INNER JOIN coleta ON
       itens_coleta.coleta_id = coleta.id
	INNER JOIN gestaofacil.grupo_residuos ON 
	 gestaofacil.itens_coleta.`grupoResiduo_id` = gestaofacil.grupo_residuos.id 
WHERE 
	 gestaofacil.itens_coleta.coleta_id = coleta.id  and gestaofacil.grupo_residuos.descricao = 'A4' and 
	 gestaofacil.grupo_residuos.status = true and coleta.fechamentoMes_id = fechamento_mes.id and coleta.pontoColeta_id = $P{PONTO_COLETA_ID}) as quantidadeA4
     
     
FROM informacoes_financeiras 
INNER JOIN fechamento_mes ON
informacoes_financeiras.id = fechamento_mes.informacaoFinanceira_id
	INNER JOIN gestaofacil.fechamento_mes_itens_ponto_coleta ON
    fechamento_mes.id = fechamento_mes_itens_ponto_coleta.fechamentoMes_id
	INNER JOIN gestaofacil.itens_informacoes_financeiras_ponto_coleta ON 
	 gestaofacil.fechamento_mes_itens_ponto_coleta.`itensPontoColeta_id` = gestaofacil.itens_informacoes_financeiras_ponto_coleta.id 
	INNER JOIN gestaofacil.ponto_coleta ON 
	 gestaofacil.itens_informacoes_financeiras_ponto_coleta.`pontoColeta_id` = gestaofacil.ponto_coleta.id 

WHERE 
	 fechamento_mes.dataInicialFechamento BETWEEN $P{DATA_INICIAL}   and  $P{DATA_FINAL} 
     AND ponto_coleta.id =  $P{PONTO_COLETA_ID} AND fechamento_mes.status is true
     GROUP BY fechamento_mes.id order by mes, ano]]>
	</queryString>
