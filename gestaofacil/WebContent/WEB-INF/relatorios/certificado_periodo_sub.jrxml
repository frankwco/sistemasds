				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{fechamentoDataDiferente}!=null && $F{fechamentoDataDiferente}==true ?" "+new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{dataInicialFechamento})+" a "+new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{dataFinalFechamento}):
""+(
        $F{mes}.equals(1) ? " Janeiro" : 
        $F{mes}.equals(2) ? " Fevereiro" :
        $F{mes}.equals(3) ? " Março" :
        $F{mes}.equals(4) ? " Abril" :
        $F{mes}.equals(5) ? " Maio" :
        $F{mes}.equals(6) ? " Junho" :
        $F{mes}.equals(7) ? " Julho" :
        $F{mes}.equals(8) ? " Agosto" :
        $F{mes}.equals(9) ? " Setembro" :
        $F{mes}.equals(10) ? " Outubro" : 
        $F{mes}.equals(11) ? " Novembro" : " Dezembro"
    )+"/"+$F{ano}]]></textFieldExpression>
			</textField>
